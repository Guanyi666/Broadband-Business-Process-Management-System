<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bbpms.dispatch.mapper.DispatchRecordMapper">

    <resultMap id="dispatchRecordMap" type="com.bbpms.dispatch.entity.DispatchRecord">
        <id property="id" column="id"/>
        <result property="workOrderId" column="work_order_id"/>
        <result property="installerId" column="installer_id"/>
        <result property="strategy" column="strategy"/>
        <result property="score" column="score"/>
        <result property="candidatesJson" column="candidates_json"/>
        <result property="reason" column="reason"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="deleted" column="deleted"/>
        <result property="version" column="version"/>
    </resultMap>

    <sql id="cols">
        r.id, r.work_order_id, r.installer_id, r.strategy, r.score,
        r.candidates_json, r.reason, r.create_time, r.update_time,
        r.create_by, r.update_by, r.deleted, r.version
    </sql>

    <!-- Paged query with data-scope clause injected by @DataScope aspect -->
    <select id="selectPageWithScope" resultMap="dispatchRecordMap">
        SELECT
        <include refid="cols"/>
        FROM dispatch_record r
        <where>
            r.deleted = 0
            <if test="q.workOrderId != null">AND r.work_order_id = #{q.workOrderId}</if>
            <if test="q.installerId != null">AND r.installer_id = #{q.installerId}</if>
            <if test="q.strategy != null and q.strategy != ''">AND r.strategy = #{q.strategy}</if>
            <if test="q.startTime != null">AND r.create_time &gt;= #{q.startTime}</if>
            <if test="q.endTime != null">AND r.create_time &lt;= #{q.endTime}</if>
        </where>
        ORDER BY r.create_time DESC
    </select>

    <select id="selectByWorkOrderId" resultMap="dispatchRecordMap">
        SELECT
        <include refid="cols"/>
        FROM dispatch_record r
        WHERE r.deleted = 0 AND r.work_order_id = #{workOrderId}
        ORDER BY r.create_time DESC
    </select>

    <select id="selectByInstaller" resultMap="dispatchRecordMap">
        SELECT
        <include refid="cols"/>
        FROM dispatch_record r
        WHERE r.deleted = 0 AND r.installer_id = #{installerId}
        ORDER BY r.create_time DESC
    </select>

    <select id="selectRecent" resultMap="dispatchRecordMap">
        SELECT
        <include refid="cols"/>
        FROM dispatch_record r
        WHERE r.deleted = 0
          AND r.create_time &gt;= DATE_SUB(NOW(), INTERVAL #{days} DAY)
        ORDER BY r.create_time DESC
    </select>

</mapper>