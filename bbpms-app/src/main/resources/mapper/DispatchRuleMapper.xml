<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bbpms.dispatch.mapper.DispatchRuleMapper">

    <resultMap id="ruleMap" type="com.bbpms.dispatch.entity.DispatchRule">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="weightDistance" column="weight_distance"/>
        <result property="weightLoad" column="weight_load"/>
        <result property="weightSkill" column="weight_skill"/>
        <result property="weightRating" column="weight_rating"/>
        <result property="radiusKm" column="radius_km"/>
        <result property="enabled" column="enabled"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="deleted" column="deleted"/>
        <result property="version" column="version"/>
    </resultMap>

    <!-- selectActive is provided via @Select annotation in the interface -->

    <select id="selectById" resultMap="ruleMap">
        SELECT * FROM dispatch_rule WHERE id = #{id} AND deleted = 0
    </select>

</mapper>