<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bbpms.order.mapper.OrderAuditLogMapper">

    <resultMap id="BaseResultMap" type="com.bbpms.order.entity.OrderAuditLog">
        <id     column="id"           property="id"/>
        <result column="order_id"     property="orderId"/>
        <result column="auditor_id"   property="auditorId"/>
        <result column="from_status"  property="fromStatus"/>
        <result column="to_status"    property="toStatus"/>
        <result column="remark"       property="remark"/>
        <result column="create_by"    property="createBy"/>
        <result column="update_by"    property="updateBy"/>
        <result column="create_time"  property="createTime"/>
        <result column="update_time"  property="updateTime"/>
        <result column="deleted"      property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_id, auditor_id, from_status, to_status, remark,
        create_by, update_by, create_time, update_time, deleted
    </sql>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM order_audit_log
        WHERE order_id = #{orderId}
          AND deleted = 0
        ORDER BY create_time ASC
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO order_audit_log
            (order_id, auditor_id, from_status, to_status, remark,
             create_by, update_by, create_time, update_time, deleted)
        VALUES
        <foreach collection="rows" item="r" separator=",">
            (#{r.orderId}, #{r.auditorId}, #{r.fromStatus}, #{r.toStatus}, #{r.remark},
             #{r.createBy}, #{r.updateBy}, NOW(), NOW(), 0)
        </foreach>
    </insert>

</mapper>
